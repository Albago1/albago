    {
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  BEGIN\r\n    INSERT INTO public.profiles (id, email, role, created_at)\r\n    VALUES (\r\n      NEW.id,\r\n      NEW.email,\r\n      'user',\r\n      now()\r\n    )\r\n    ON CONFLICT (id) DO NOTHING;\r\n    RETURN NEW;\r\n  END;\r\n  $function$\n",
