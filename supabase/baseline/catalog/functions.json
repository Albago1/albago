      "def": "CREATE OR REPLACE FUNCTION public.update_events_search_vector()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\n  BEGIN\r\n    NEW.search_vector :=\r\n      setweight(to_tsvector('simple', coalesce(NEW.title, '')), 'A') ||\r\n      setweight(to_tsvector('simple', coalesce(NEW.description, '')), 'B') ||\r\n      setweight(to_tsvector('simple', coalesce(NEW.category, '')), 'C');\r\n    RETURN NEW;\r\n  END;\r\n  $function$\n",
      "name": "update_events_search_vector",
