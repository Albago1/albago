    {
      "args": "p_organizer_id uuid",
      "def": "CREATE OR REPLACE FUNCTION public.organizer_avatar_url(p_organizer_id uuid)\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  select p.avatar_url\r\n  from public.profiles p\r\n  join public.organizers o on o.id = p.id\r\n  where p.id = p_organizer_id\r\n$function$\n",
