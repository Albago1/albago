    {
      "args": "p_submission_id uuid, p_sections jsonb, p_cover_in_gallery boolean",
      "def": "CREATE OR REPLACE FUNCTION public.set_submission_media(p_submission_id uuid, p_sections jsonb, p_cover_in_gallery boolean)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare\r\n  uid uuid := auth.uid();\r\nbegin\r\n  if uid is null then\r\n    raise exception 'not_authenticated' using errcode = '28000';\r\n  end if;\r\n\r\n  update public.event_submissions s set\r\n    content_sections = public._normalize_media_sections(p_sections),\r\n    cover_in_gallery = coalesce(p_cover_in_gallery, true)\r\n  where s.id = p_submission_id\r\n    and (s.submitted_by_user_id = uid or public.is_admin());\r\n\r\n  if not found then\r\n    raise exception 'not_found_or_not_owner';\r\n  end if;\r\nend;\r\n$function$\n",
